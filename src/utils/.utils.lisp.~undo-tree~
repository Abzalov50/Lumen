([nil nil ((#("(defun get-col (entity key &optional default)
  \"Récupère une valeur dans une entité (CLOS ou Alist) avec une correspondance flexible
   sur les clés (case-insensitive, interchangeabilité -/_), comme %aget*.\"
  (labels ((norm (k)
             \"Normalise la clé : string minuscule avec _ au lieu de -\"
             (let ((s (string-downcase (etypecase k
                                         (symbol (symbol-name k))
                                         (string k)))))
               (substitute #\\_ #\\- s)))
           
           (fuzzy-match-p (a b)
             \"Vérifie si deux clés correspondent après normalisation\"
             (string= (norm a) (norm b))))

    (cond
      ;; ----------------------------------------------------------------
      ;; CAS 1 : Objet CLOS
      ;; ----------------------------------------------------------------
      ((typep entity 'standard-object)
       (let* ((pkg (symbol-package (class-name (class-of entity))))
              (key-str (string key))
              ;; On essaie de deviner le symbole du slot.
              ;; Comme on veut être flexible (\"user_id\" doit trouver \"USER-ID\"),
              ;; on tente plusieurs variations courantes via find-symbol.
              (candidates (list key-str                                     ;; Exact
                                (string-upcase key-str)                     ;; Standard Lisp (USER-ID)
                                (string-downcase key-str)                   ;; Lower case
                                (string-upcase (substitute #\\- #\\_ key-str));; USER_ID -> USER-ID
                                (string-upcase (substitute #\\_ #\\- key-str));; USER-ID -> USER_ID
                                ))
              ;; On cherche le premier symbole qui existe dans le package ET qui est un slot
              (slot-sym (loop for c in candidates
                              for sym = (find-symbol c pkg)
                              when (and sym (slot-exists-p entity sym))
                                return sym)))
         
         (if (and slot-sym (slot-boundp entity slot-sym))
             (slot-value entity slot-sym)
             default)))

      ;; ----------------------------------------------------------------
      ;; CAS 2 : Liste Associative (Alist)
      ;; ----------------------------------------------------------------
      ((listp entity)
       ;; On utilise assoc avec notre fonction de test fuzzy
       (let ((cell (assoc key entity :test #'fuzzy-match-p)))
         (if cell (cdr cell) default)))

      ;; ----------------------------------------------------------------
      ;; CAS 3 : Fallback
      ;; ----------------------------------------------------------------
      (t default))))
