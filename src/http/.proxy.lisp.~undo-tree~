(defun %ensure-simple-byte-array (data)
  \"Garantit que les données sortent en (simple-array (unsigned-byte 8) (*))\"
  (typecase data
    ((simple-array (unsigned-byte 8) (*)) data)
    ((vector (unsigned-byte 8))
     (let ((arr (make-array (length data) :element-type '(unsigned-byte 8))))
       (replace arr data)
       arr))
    (string
     (ignore-errors (trivial-utf-8:string-to-utf-8-bytes data)))
    (t (make-array 0 :element-type '(unsigned-byte 8)))))

